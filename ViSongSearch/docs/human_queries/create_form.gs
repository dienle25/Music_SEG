function createForm() {
  var form = FormApp.create("ViSongSearch: bạn tìm bài hát thế nào khi quên tên?");
  form.setDescription("Khảo sát này thu cách mọi người gõ tìm một bài hát khi không nhớ tên bài, cho một nghiên cứu về máy tìm kiếm bài hát tiếng Việt (môn SEG301 và TMG301, Đại học FPT). Khảo sát ẩn danh, không hỏi tên hay email, mất khoảng 5–10 phút. Câu trả lời chỉ dùng để đánh giá hệ thống tìm kiếm và có thể được công bố ở dạng ẩn danh cùng bài báo. Bạn có thể dừng bất cứ lúc nào.\n\nCách làm: mỗi câu hỏi là một bài hát (tên và ca sĩ). Với bài bạn biết, hãy tưởng tượng bạn quên mất tên bài và gõ đúng như bạn sẽ gõ vào ô tìm kiếm: một câu lời bạn nhớ (nhớ sai cũng được), hoặc mô tả bài hát. Không gõ tên bài, không tra lời trên mạng. Bỏ trống những bài bạn không biết. Hãy trả lời ít nhất 5 bài.");
  form.setCollectEmail(false);
  form.setShuffleQuestions(true);
  form.setProgressBar(false);
  form.setConfirmationMessage("Cảm ơn bạn! Câu trả lời đã được ghi lại.");
  form.addMultipleChoiceItem()
      .setTitle("Khi tìm kiếm bằng tiếng Việt, bạn thường gõ:")
      .setChoiceValues(["Có dấu đầy đủ", "Không dấu", "Lúc có dấu, lúc không"])
      .setRequired(true);
  form.addMultipleChoiceItem()
      .setTitle("Bạn đang làm khảo sát trên:")
      .setChoiceValues(["Điện thoại", "Máy tính"])
      .setRequired(true);
  SONGS.forEach(function (s) {
    form.addTextItem()
        .setTitle(s[1] + " (" + s[2] + ") #" + s[0])
        .setHelpText("Gõ như khi tìm kiếm: lời bạn nhớ hoặc mô tả bài. Không gõ tên bài. Gõ có dấu hay không dấu tùy thói quen của bạn. Bỏ trống nếu không biết bài.")
        .setRequired(false);
  });
  Logger.log("Link to share: " + form.getPublishedUrl());
  Logger.log("Edit link: " + form.getEditUrl());
}
